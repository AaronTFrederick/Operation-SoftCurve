# Copy this file to .env and fill in real values. Never commit the real .env file.

# Discord bot token — from https://discord.com/developers/applications, your app's "Bot" tab
DISCORD_TOKEN=

# Optional: a Discord server (guild) ID to sync slash commands to instantly.
# Leave blank to sync globally instead (works everywhere, but can take up to an hour
# to show up after each restart/command change — fine for normal use once it's live).
GUILD_ID=

# No shared API key here on purpose — each host gets their own personal key via
# the /hostkey Discord command instead of one secret handed to everyone. See README.

# Where the SQLite database file lives.
DB_PATH=hardrank.sqlite

# HTTP listener for the plugin's match reports.
HTTP_HOST=0.0.0.0
HTTP_PORT=8000
